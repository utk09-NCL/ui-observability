{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["tests/**/*", "playground/**/*", "**/*.test.ts"]
}

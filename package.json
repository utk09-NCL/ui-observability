{
  "name": "@utk09/ui-observability",
  "version": "0.11.0",
  "description": "UI observability and logging for browser, OpenFin and webview applications",
  "license": "Apache-2.0",
  "keywords": [
    "observability",
    "logging",
    "telemetry",
    "otlp",
    "opentelemetry",
    "browser",
    "frontend",
    "microfrontend",
    "openfin",
    "web-vitals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utk09-NCL/ui-observability.git"
  },
  "homepage": "https://github.com/utk09-NCL/ui-observability#readme",
  "bugs": {
    "url": "https://github.com/utk09-NCL/ui-observability/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "bin": {
    "uiobs": "bin/uiobs.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:vanilla\" \"pnpm run dev:ingest\" \"pnpm run dev:cross-origin\"",
    "dev:vanilla": "pnpm --filter @example/vanilla run dev",
    "dev:ingest": "node tools/mock-ingest-server.mjs",
    "dev:cross-origin": "vite --config vite.cross-origin.config.ts",
    "example:react": "pnpm --filter @example/react run dev",
    "example:angular": "pnpm --filter @example/angular run dev",
    "example:microfrontend": "concurrently -k \"pnpm --filter @example/mf-blotter run dev\" \"pnpm --filter @example/mf-ticket run dev\" \"pnpm --filter @example/mf-host run dev\"",
    "example:console-only": "pnpm --filter @example/console-only run dev",
    "build": "rimraf dist && tsc --project tsconfig.build.json && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:peers": "node tools/check-peer-imports.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:dev": "node tools/check-dev-server.mjs",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run build && pnpm run lint && pnpm run check:peers && pnpm run check:size && pnpm run check:dev && pnpm run test:coverage",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1",
    "web-vitals": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "web-vitals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:library",
    "@opentelemetry/api": "catalog:library",
    "@types/node": "catalog:library",
    "@vitest/coverage-istanbul": "catalog:library",
    "concurrently": "catalog:library",
    "eslint": "catalog:library",
    "eslint-config-prettier": "catalog:library",
    "fake-indexeddb": "catalog:library",
    "happy-dom": "catalog:library",
    "prettier": "catalog:library",
    "rimraf": "catalog:library",
    "typescript": "catalog:library",
    "typescript-eslint": "catalog:library",
    "vite": "catalog:library",
    "vitest": "catalog:library",
    "web-vitals": "catalog:library"
  },
  "packageManager": "pnpm@12.18.0"
}

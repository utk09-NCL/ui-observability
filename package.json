{
  "name": "@utk09/ui-observability",
  "version": "1.1.0",
  "description": "UI observability and logging for browser, OpenFin and webview applications",
  "license": "Apache-2.0",
  "keywords": [
    "observability",
    "logging",
    "telemetry",
    "otlp",
    "opentelemetry",
    "browser",
    "frontend",
    "microfrontend",
    "openfin",
    "web-vitals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utk09-NCL/ui-observability.git"
  },
  "homepage": "https://github.com/utk09-NCL/ui-observability#readme",
  "bugs": {
    "url": "https://github.com/utk09-NCL/ui-observability/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.3",
      "onFail": "error"
    }
  },
  "bin": {
    "uiobs": "bin/uiobs.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:vanilla\" \"pnpm run dev:ingest\" \"pnpm run dev:cross-origin\"",
    "dev:vanilla": "pnpm --filter @example/vanilla run dev",
    "dev:ingest": "node tools/mock-ingest-server.mjs",
    "dev:app-api": "node tools/mock-app-api.mjs",
    "dev:cross-origin": "vite --config vite.cross-origin.config.ts",
    "example:react": "concurrently -k \"pnpm --filter @example/react run dev\" \"pnpm run dev:ingest\" \"pnpm run dev:app-api\" \"pnpm run dev:cross-origin\"",
    "example:react-custom-backend": "concurrently -k \"pnpm --filter @example/react-custom-backend run dev\" \"pnpm run dev:ingest\" \"pnpm run dev:app-api\"",
    "example:angular": "pnpm --filter @example/angular run dev",
    "example:microfrontend": "concurrently -k \"pnpm --filter @example/mf-blotter run dev\" \"pnpm --filter @example/mf-ticket run dev\" \"pnpm --filter @example/mf-host run dev\"",
    "example:console-only": "pnpm --filter @example/console-only run dev",
    "build": "rimraf dist && tsc --project tsconfig.build.json && node tools/finish-declarations.mjs && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:playground": "playwright test --config e2e/playground/playwright.config.ts",
    "test:collector": "node tools/check-collector.mjs",
    "bench:release": "node tools/bench-release.mjs",
    "typecheck": "tsc --noEmit",
    "check:peers": "node tools/check-peer-imports.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:dev": "node tools/check-dev-server.mjs",
    "check:consumers": "node tools/check-consumers.mjs",
    "prepare": "pnpm run build",
    "fix": "pnpm run lint:fix && pnpm run format",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run build && pnpm run lint && pnpm run check:peers && pnpm run check:size && pnpm run check:dev && pnpm run check:consumers && pnpm run test:coverage",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1",
    "@rrweb/record": "^2",
    "web-vitals": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@rrweb/record": {
      "optional": true
    },
    "web-vitals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:library",
    "@opentelemetry/api": "catalog:library",
    "@playwright/test": "catalog:library",
    "@types/node": "catalog:library",
    "@vitest/coverage-istanbul": "catalog:library",
    "concurrently": "catalog:library",
    "eslint": "catalog:library",
    "eslint-config-prettier": "catalog:library",
    "fake-indexeddb": "catalog:library",
    "happy-dom": "catalog:library",
    "prettier": "catalog:library",
    "rimraf": "catalog:library",
    "typescript": "catalog:library",
    "typescript-eslint": "catalog:library",
    "vite": "catalog:library",
    "vitest": "catalog:library",
    "web-vitals": "catalog:library",
    "ws": "catalog:library"
  },
  "packageManager": "pnpm@12.21.0"
}

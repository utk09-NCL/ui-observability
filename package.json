{
  "name": "@utk09/ui-observability",
  "version": "0.5.0",
  "description": "UI observability and logging for browser, OpenFin and webview applications",
  "license": "Apache-2.0",
  "keywords": [
    "observability",
    "logging",
    "telemetry",
    "otlp",
    "opentelemetry",
    "browser",
    "frontend",
    "microfrontend",
    "openfin",
    "web-vitals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utk09-NCL/ui-observability.git"
  },
  "homepage": "https://github.com/utk09-NCL/ui-observability#readme",
  "bugs": {
    "url": "https://github.com/utk09-NCL/ui-observability/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "playground/react",
    "playground/angular",
    "playground/microfrontend/host",
    "playground/microfrontend/remote-blotter",
    "playground/microfrontend/remote-ticket",
    "playground/console-only"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:vanilla": "vite",
    "dev:ingest": "node tools/mock-ingest-server.mjs",
    "dev:cross-origin": "vite --config vite.cross-origin.config.ts",
    "example:react": "npm run dev --workspace @example/react",
    "example:angular": "npm run dev --workspace @example/angular",
    "example:microfrontend": "concurrently -k \"npm run dev --workspace @example/mf-blotter\" \"npm run dev --workspace @example/mf-ticket\" \"npm run dev --workspace @example/mf-host\"",
    "example:console-only": "npm run dev --workspace @example/console-only",
    "build": "rimraf dist && tsc --project tsconfig.build.json && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:version": "node tools/check-version-sync.mjs",
    "check:peers": "node tools/check-peer-imports.mjs",
    "verify": "npm run format:check && npm run check:version && npm run typecheck && npm run lint && npm run build && npm run check:peers && npm run test:coverage",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1",
    "web-vitals": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "web-vitals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "web-vitals": "6.2.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true
  }
}

{
  "name": "ui-observability",
  "version": "1.0.0",
  "description": "UI observability and logging for browser, OpenFin and webview applications",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20.19.0" },
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:vanilla": "vite",
    "dev:ingest": "node tools/mock-ingest-server.mjs",
    "dev:cross-origin": "vite --config vite.cross-origin.config.ts",
    "build": "rimraf dist && tsc --project tsconfig.build.json && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "dexie": "4.4.5",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "web-vitals": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "web-vitals": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.6",
    "rimraf": "6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-vitals": "6.1.1"
  }
}
